rules_version = '2';

// Who can do what. Everyone signs in with Google; the "staff" collection
// (kept in sync from Admin > People) lists who's allowed in, keyed by
// lowercase email: { personId, isAdmin }.
//
// - Staff can read what the app shows them, log and edit their own hours
//   (until invoiced, at their own pay rate), and manage subtasks.
// - Admins can do everything else: people, projects, tasks, assignments,
//   approvals and invoices.
// - Anyone not on the list (or not signed in) gets nothing.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function email() { return request.auth.token.email.lower(); }
    function staffPath() { return /databases/$(database)/documents/staff/$(email()); }
    function isStaff() { return signedIn() && exists(staffPath()); }
    function isAdmin() { return isStaff() && get(staffPath()).data.isAdmin == true; }
    function myPersonId() { return get(staffPath()).data.personId; }
    function myRate() { return get(/databases/$(database)/documents/people/$(myPersonId())).data.rate; }
    function isInternal(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data.get("internal", false) == true;
    }

    match /staff/{staffEmail} {
      allow read: if signedIn() && (staffEmail == email() || isAdmin());
      allow write: if isAdmin();
    }

    match /people/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /projects/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /tasks/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /assignments/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /invoices/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // App-wide settings (last Google Sheet sync, last backup).
    match /settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Subtasks and timeline events.
    match /dueDates/{id} {
      allow read, write: if isStaff();
    }

    // Project expenses (staff add their own; admins/PMs approve, record
    // subconsultant invoices, invoice them and mark them reimbursed).
    match /expenses/{id} {
      function myOpenExpense(data) {
        return data.personId == myPersonId()
          && data.kind == "project"
          && data.get("approved", false) == false
          && data.get("invoiced", false) == false
          && data.get("reimbursed", false) == false;
      }

      allow read: if isStaff();
      allow create: if isAdmin() || (isStaff() && myOpenExpense(request.resource.data));
      allow update: if isAdmin()
        || (isStaff() && myOpenExpense(resource.data) && myOpenExpense(request.resource.data));
      allow delete: if isAdmin() || (isStaff() && myOpenExpense(resource.data));
    }

    match /timeEntries/{id} {
      // Your own entry that hasn't been invoiced.
      function mineAndOpen(data) {
        return data.personId == myPersonId()
          && data.get("invoiced", false) == false
          && data.get("paid", false) == false;
      }
      // What staff may save: their own, not invoiced, and not approved
      // (except internal projects, which auto-approve).
      function okToSave(data) {
        return mineAndOpen(data)
          && (data.get("approved", false) == false || isInternal(data.projectId));
      }

      allow read: if isStaff();
      allow create: if isAdmin()
        || (isStaff() && okToSave(request.resource.data) && request.resource.data.rate == myRate());
      allow update: if isAdmin()
        || (isStaff() && mineAndOpen(resource.data) && okToSave(request.resource.data)
            && request.resource.data.rate == resource.data.rate);
      allow delete: if isAdmin() || (isStaff() && mineAndOpen(resource.data));
    }
  }
}
