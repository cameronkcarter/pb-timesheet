rules_version = '2';

// This app has no real per-person login (see README) — every visitor is
// signed in anonymously (see firebase-config.js) so we can at least require
// a Firebase Auth session to touch the database. This blocks anyone/any bot
// hitting Firestore directly without ever loading the app; it does NOT
// restrict what a logged-in team member can read or write, since the app
// itself doesn't distinguish people that way yet.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
